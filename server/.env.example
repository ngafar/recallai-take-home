# Workspace region. Must match the apiUrl the sidecar passes to RecallAiSdk.init.
# US pay-as-you-go: https://us-west-2.recall.ai
# US monthly:       https://us-east-1.recall.ai
# EU:               https://eu-central-1.recall.ai
# Japan:            https://ap-northeast-1.recall.ai
RECALL_API_URL=https://us-west-2.recall.ai

# From the Recall dashboard for that same region. Never put this in the sidecar or the Tauri app.
RECALL_API_KEY=

PORT=3000
